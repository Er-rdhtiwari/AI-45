{
  "project_name": "abnormal-expense-review",
  "schema_version": "1.0.0",
  "dataset_version": "expenses-synthetic-v1",
  "model_version": "expense-risk-v1",
  "random_seed": 45,
  "row_count": 12000,
  "splits": {
    "train": 0.60,
    "calibration": 0.15,
    "validation": 0.10,
    "test": 0.15
  },
  "policy": {
    "false_negative_cost_usd": 500.0,
    "false_positive_review_cost_usd": 15.0,
    "max_review_rate": 0.12,
    "threshold_selection_capacity_buffer": 0.01,
    "borderline_probability_width": 0.04,
    "max_ood_warnings_before_abstain": 2
  },
  "performance_targets": {
    "api_p95_latency_ms": 100.0,
    "minimum_test_average_precision": 0.20
  }
}
