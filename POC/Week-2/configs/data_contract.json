{
  "schema_version": "1.0.0",
  "primary_key": "expense_id",
  "event_time": "submitted_at",
  "label": "is_abnormal",
  "label_definition": "1 only when a post-submission audit confirms a material policy violation, duplicate, fabricated evidence, or otherwise abnormal expense; 0 otherwise.",
  "model_features": [
    "amount_usd",
    "policy_limit_usd",
    "amount_to_policy_ratio",
    "days_since_expense",
    "prior_30d_claim_count",
    "prior_30d_total_usd",
    "employee_tenure_months",
    "duplicate_7d_count",
    "receipt_attached",
    "weekend_submission",
    "outside_business_hours",
    "cross_border",
    "region",
    "department",
    "employee_level",
    "expense_category",
    "merchant_risk_tier",
    "country_risk_tier",
    "payment_method"
  ],
  "evaluation_only_columns": ["employee_gender"],
  "excluded_columns": ["expense_id", "employee_id", "submitted_at", "audit_completed_at", "employee_gender", "is_abnormal"],
  "columns": {
    "expense_id": {"type": "string", "nullable": false},
    "employee_id": {"type": "string", "nullable": false},
    "submitted_at": {"type": "datetime", "nullable": false},
    "audit_completed_at": {"type": "datetime", "nullable": false},
    "employee_gender": {"type": "string", "nullable": false, "allowed": ["Female", "Male", "Nonbinary"]},
    "region": {"type": "string", "nullable": false, "allowed": ["APAC", "EMEA", "LATAM", "North America"]},
    "department": {"type": "string", "nullable": false, "allowed": ["Engineering", "Finance", "Operations", "Sales", "Support"]},
    "employee_level": {"type": "string", "nullable": false, "allowed": ["IC1-2", "IC3-4", "Manager", "Director+"]},
    "expense_category": {"type": "string", "nullable": false, "allowed": ["Airfare", "Lodging", "Meals", "Mileage", "Office", "Taxi"]},
    "merchant_risk_tier": {"type": "string", "nullable": false, "allowed": ["low", "medium", "high"]},
    "country_risk_tier": {"type": "string", "nullable": false, "allowed": ["low", "medium", "high"]},
    "payment_method": {"type": "string", "nullable": false, "allowed": ["corporate_card", "personal_card", "cash"]},
    "amount_usd": {"type": "float", "nullable": false, "min": 1.0, "max": 25000.0},
    "policy_limit_usd": {"type": "float", "nullable": false, "min": 20.0, "max": 10000.0},
    "amount_to_policy_ratio": {"type": "float", "nullable": false, "min": 0.0001, "max": 1250.0},
    "days_since_expense": {"type": "integer", "nullable": false, "min": 0, "max": 180},
    "prior_30d_claim_count": {"type": "integer", "nullable": false, "min": 0, "max": 60},
    "prior_30d_total_usd": {"type": "float", "nullable": false, "min": 0.0, "max": 100000.0},
    "employee_tenure_months": {"type": "integer", "nullable": false, "min": 0, "max": 600},
    "duplicate_7d_count": {"type": "integer", "nullable": false, "min": 0, "max": 10},
    "receipt_attached": {"type": "boolean", "nullable": false},
    "weekend_submission": {"type": "boolean", "nullable": false},
    "outside_business_hours": {"type": "boolean", "nullable": false},
    "cross_border": {"type": "boolean", "nullable": false},
    "is_abnormal": {"type": "integer", "nullable": false, "allowed": [0, 1]}
  },
  "quality_rules": {
    "maximum_column_missing_rate": 0.0,
    "maximum_duplicate_primary_keys": 0,
    "minimum_rows": 1000,
    "maximum_target_rate": 0.30,
    "minimum_target_rate": 0.01
  }
}
